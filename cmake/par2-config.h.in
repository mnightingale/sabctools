/* Generated by cmake/par2.cmake - do not edit.
 *
 * par2 tests every one of these with #ifdef, so a false entry must be absent
 * rather than defined to 0: "#define HAVE_ENDIAN_H 0" would enable the feature.
 * The cmakedefine directives below write the commented-out form when their
 * variable is false, which is autoconf's behaviour and the reason this is a
 * template rather than a string built in CMake.
 *
 * Careful with the word cmakedefine in comments: configure_file substitutes
 * that directive wherever it appears, comments included, and the replacement
 * closes the comment block. That is what the wording above is avoiding.
 */

/* Only creatorpacket.cpp uses these, to stamp who made a recovery file. */
#define PACKAGE "@PAR2_PACKAGE@"
#define VERSION "@PAR2_VERSION@"

#cmakedefine STDC_HEADERS 1

#cmakedefine HAVE_STDIO_H 1
#cmakedefine HAVE_STDLIB_H 1
#cmakedefine HAVE_LIMITS_H 1
#cmakedefine HAVE_MEMORY_H 1
#cmakedefine HAVE_UNISTD_H 1
#cmakedefine HAVE_SYS_TYPES_H 1
#cmakedefine HAVE_SYS_STAT_H 1

/* Directory reading: dirent.h everywhere modern, the rest are pre-POSIX. */
#cmakedefine HAVE_DIRENT_H 1
#cmakedefine HAVE_SYS_NDIR_H 1
#cmakedefine HAVE_SYS_DIR_H 1
#cmakedefine HAVE_NDIR_H 1

#cmakedefine HAVE_ENDIAN_H 1
#cmakedefine HAVE_MEMCPY 1
#cmakedefine HAVE_FSEEKO 1
#cmakedefine HAVE_POSIX_FADVISE 1

/* letype.h, md5.cpp and reedsolomon.cpp switch on __BYTE_ORDER, which
 * libpar2internal.h derives from this. Getting it wrong is silent. */
#cmakedefine WORDS_BIGENDIAN 1
